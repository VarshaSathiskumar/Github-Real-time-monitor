# URL behind the "View Source on GitHub" button
VITE_GITHUB_REPO_URL=https://github.com/VarshaSathiskumar/Github-Real-time-monitor
# Leave empty to use the same origin (nginx or the Vite dev proxy forwards /api and /ws)
VITE_API_BASE_URL=
VITE_WS_URL=

# Vercel: set VITE_API_BASE_URL=https://api.example.com and VITE_WS_URL=wss://api.example.com/ws
# in the project's Environment Variables (see docs/vercel.md)
