# Copy to terraform.tfvars (git-ignored) and edit.
region        = "us-east-1"
instance_type = "t3.large"
repo_url      = "https://github.com/VarshaSathiskumar/Github-Real-time-monitor.git"
repo_ref      = "main"

# domain      = "pulse.example.com"   # enables HTTPS via Caddy; create the A record after apply
# github_token = ""                    # prefer: export TF_VAR_github_token=...
# ssh_allowed_cidrs = ["203.0.113.4/32"]
# key_name          = "my-key"
