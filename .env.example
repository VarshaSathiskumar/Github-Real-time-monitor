# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (required) ---
POSTGRES_USER=githubpulse
POSTGRES_PASSWORD=change-me

# --- GitHub API (optional) ---
# Without a token GitHub allows 60 requests/hour, so only one page of events is polled per minute.
# A token (no scopes needed) raises the limit to 5000/hour and enables multi-page polling.
GITHUB_TOKEN=
GITHUB_PAGES=3

# --- Frontend ---
# Target of the "View Source on GitHub" button (baked in at build time)
GITHUB_REPO_URL=https://github.com/VarshaSathiskumar/Github-Real-time-monitor
HTTP_PORT=8088
CORS_ALLOWED_ORIGINS=http://localhost:8088

# --- HTTPS (compose profile "https") ---
# DOMAIN=pulse.example.com

# --- Activity score weights (optional) ---
# SCORE_WEIGHT_PUSH=2
# SCORE_WEIGHT_PULL_REQUEST=3
# SCORE_WEIGHT_FORK=2
# SCORE_WEIGHT_OTHER=1

# --- Momentum detector (optional) ---
# MOMENTUM_MIN_EVENTS=8
